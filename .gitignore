# Deny all by default (old aggressive whitelist style kept for compatibility)
*

# Core project files
!/
!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!Dockerfile
!LICENSE
!README.md
!autoresearch.sh
!docker-compose.yml
!haproxy.cfg
!info.json
!.gitignore

# Resources (small)
!resources/
!resources/example-payloads.json
!resources/example-references.json
!resources/index.bin
!resources/mcc_risk.json
!resources/references.json.gz

# Zig source (the new partitioned architecture lives here)
!zig/
!zig/build.zig
!zig/src/
!zig/src/*.zig

# Build artifacts (always ignore)
zig-out/
zig-cache/
*.o
*.a

# Large generated data (use the same pattern as rinha-2026-c — copy or LFS)
data/
!data/.gitkeep
